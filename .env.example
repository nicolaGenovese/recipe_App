# Copy this file to .env.local and keep only the lines you need.

# Local JSON archive. Without it the app uses data/recipes.json in this folder.
# A relative path starts from this folder.
# DATA_FILE=data/recipes.json

# Neon Postgres. When set, it replaces the local file.
# In Neon Console, open your project and choose Connect to copy the connection string.
# Never commit the real value or place it in browser code.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Shared password for the whole app. Without it the app is open (fine on your own computer).
# On Vercel it is required: without it every page asks for a password that does not exist.
# APP_PASSWORD=choose-a-long-password
